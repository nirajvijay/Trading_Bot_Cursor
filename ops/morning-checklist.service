[Unit]
Description=NIFTY RADAR morning checklist preparation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nifty-radar
Group=nifty-radar
WorkingDirectory=/opt/nifty-radar/current
EnvironmentFile=/opt/nifty-radar/secrets/api.env
EnvironmentFile=-/opt/nifty-radar/secrets/morning-checklist.env
ExecStart=/opt/nifty-radar/venv/bin/python3 morning_checklist.py
TimeoutStartSec=31min
TimeoutStopSec=15s
KillMode=control-group
Restart=on-abnormal
RestartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nifty-radar/data /opt/nifty-radar/logs /opt/nifty-radar/run /opt/nifty-radar/secrets
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=

